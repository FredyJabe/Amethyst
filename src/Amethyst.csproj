<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- FlatWorld.cs belonged to an earlier release. Exclude it for users who
       unpack updates over an existing project without deleting obsolete files. -->
  <ItemGroup>
    <Compile Remove="FlatWorld.cs" />
    <!-- Exclude old monolith files left when users overlay source patches. -->
    <Compile Remove="TerrainWorld.cs;TerrainGenerator.cs;ChunkLightEngine.cs;ChunkPreparationScheduler.cs;ChunkPerformance.cs;WorldStorage.cs;MinecraftServer.cs;PlayerRegistry.cs;PlayerPackets.cs;SpawnPackets.cs;WorldClock.cs;OperatorStore.cs;GameModeProtocol.cs;ChatProtocol.cs;CommandTree.cs;ConsoleCommandCompletion.cs;Generation/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="VanillaRegistries/registry_entries.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="VanillaRegistries/35_update_tags.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
