<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Amethyst.csproj" />
    <InternalsVisibleTo Include="BlockTests" />
  </ItemGroup>
  <Target Name="InstallShard" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)/../../shards/installed/gameplay" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../../shards/installed/gameplay" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/shard.yaml" DestinationFolder="$(MSBuildProjectDirectory)/../../shards/installed/gameplay" Condition="!Exists('$(MSBuildProjectDirectory)/../../shards/installed/gameplay/shard.yaml')" />
  </Target>
</Project>
